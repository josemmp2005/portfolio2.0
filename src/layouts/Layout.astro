---
import '../styles/index.css';
import Navbar from '../components/Navbar.astro';

interface Props {
  title?: string;
}

const { title = 'Portfolio Dev' } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=EB+Garamond:ital,wght@0,400;0,500;1,400&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <video class="bg-video" autoplay muted loop playsinline>
      <source src="/video/Animated_Japanese_ukiyo-e_scene_202607031203.mp4" type="video/mp4" />
    </video>
    <Navbar />
    <slot />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
