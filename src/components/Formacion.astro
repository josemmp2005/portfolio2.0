---
import SectionFooter from './SectionFooter.astro';
---

<div class="h-panel" id="formacion">
  <div class="panel-inner">
    <div class="skills-eyebrow reveal">
      <span class="skills-index">04</span>
      <span class="eyebrow-dash">&mdash;&mdash;</span>
      <span data-i18n="formacionTitle">Formación</span>
    </div>
    <h2 class="reveal" data-i18n="formacionTitle">Formación</h2>

    <div class="timeline content-card reveal">
      <div class="timeline-item">
        <span class="timeline-years">2021 — 2023</span>
        <div class="timeline-body">
          <h3>S.M.R</h3>
          <p data-i18n="edu1Text">Sistemas Microinformáticos y Redes</p>
          <span class="timeline-place">IES Antonio Gala</span>
        </div>
      </div>

      <div class="timeline-item">
        <span class="timeline-years">2023 — 2025</span>
        <div class="timeline-body">
          <h3>DAW</h3>
          <p data-i18n="edu2Text">Desarrollo de Aplicaciones Web</p>
          <span class="timeline-place">IES Gran Capitán</span>
        </div>
      </div>

      <div class="timeline-item">
        <span class="timeline-years">2025 — 2026</span>
        <div class="timeline-body">
          <h3 data-i18n="edu3Title">Especialización IA y Big Data</h3>
          <p data-i18n="edu3Text">Especialización en Inteligencia Artificial y Big Data.</p>
          <span class="timeline-place">Davante Medac</span>
        </div>
      </div>
    </div>

    <SectionFooter />
  </div>
</div>
