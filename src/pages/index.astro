---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Skills from '../components/Skills.astro';
import Proyectos from '../components/Proyectos.astro';
import SobreMi from '../components/SobreMi.astro';
import Formacion from '../components/Formacion.astro';
import Contacto from '../components/Contacto.astro';

export const prerender = true;
---

<Layout title="Portfolio Dev">
  <Hero />

  <section class="h-scroll-wrapper" id="hScrollWrapper">
    <div class="h-scroll-sticky">
      <div class="h-scroll-track" id="hScrollTrack">
        <Skills />
        <Proyectos />
        <SobreMi />
        <Formacion />
      </div>
    </div>
  </section>

  <main>
    <Contacto />
  </main>
</Layout>
